{
  "name": "ovis",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "description": "Ovis, the browser and phone client for herdr - live herdr workspaces, panes and agents in a web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devswha/ovis.git"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun scripts/build-cache.ts",
    "build:shell": "bun --bun vite build --mode shell",
    "server": "bun run server/index.ts",
    "start": "bun run build && bun run server/managed.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "check": "bun scripts/check.ts",
    "test": "bun test",
    "test:unit": "bun scripts/ci-tests.ts unit",
    "test:integration": "bun scripts/ci-tests.ts integration",
    "test:ui": "bun run build && bun scripts/ui-regression.ts && bun scripts/ui-contexts-regression.ts && bun scripts/ui-contexts-layout-regression.ts && bun scripts/sticky-modifiers-regression.ts",
    "generate:types": "bun run scripts/generate-protocol-types.ts",
    "generate:themes": "bun run scripts/generate-themes.ts",
    "generate:case-folding": "bun run scripts/generate-case-folding.ts",
    "generate:confusables": "bun run scripts/generate-confusables.ts",
    "build:remote": "bun run scripts/build-remote-bundle.ts",
    "build:site": "bun scripts/build-site.ts",
    "test:ssh": "bun run scripts/ssh-integration.ts"
  },
  "dependencies": {
    "@atomic-editor/editor": "0.6.2",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@legendapp/list": "3.3.5",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@lydell/node-pty": "1.1.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@pierre/diffs": "1.5.2",
    "@replit/codemirror-indentation-markers": "6.5.3",
    "@tanstack/highlight": "^1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "base64-js": "1.5.1",
    "jsonc-parser": "3.3.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tweetnacl": "1.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.49.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.4"
  },
  "patchedDependencies": {
    "@legendapp/list@3.3.5": "patches/@legendapp%2Flist@3.3.5.patch",
    "@xterm/xterm@6.0.0": "patches/@xterm%2Fxterm@6.0.0.patch",
    "@tanstack/highlight@1.0.0": "patches/@tanstack%2Fhighlight@1.0.0.patch"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "dompurify": "3.4.17",
    "katex": "0.18.9"
  }
}
